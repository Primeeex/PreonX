# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cc,cxx}]
indent_size = 4

[*.{rs}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{cmake,CMakeLists.txt}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{toml}]
indent_size = 4

[*.{md}]
trim_trailing_whitespace = false
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
