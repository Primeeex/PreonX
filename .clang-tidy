---
Checks: >
  -*,
  abseil-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  clang-diagnostic-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-vararg,
  google-*,
  -google-build-using-namespace,
  -google-explicit-constructor,
  -google-runtime-int,
  hicpp-*,
  -hicpp-avoid-c-arrays,
  -hicpp-named-parameter,
  -hicpp-vararg,
  misc-*,
  -misc-include-cleaner,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter

WarningsAsErrors: ''

HeaderFilterRegex: '(foundation|primeon|luminium|cambyses|cochise|jubal|integration|sdk)/.*'

CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: '0'
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'
  - key: readability-implicit-bool.Conversion
    value: '0'
  - key: readability-implicit-bool.Collapsing
    value: '1'

ExtraArgs:
  - '-std=c++20'
  - '-I./foundation/include'
  - '-I./primeon/include'
  - '-I./luminium/include'
  - '-I./cambyses/include'
  - '-I./cochise/include'
  - '-I./jubal/include'
  - '-I./integration/include'
  - '-I./sdk/include'
